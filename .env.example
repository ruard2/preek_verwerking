# Kopieer dit bestand naar ".env" en vul je eigen sleutel in.
# .env wordt NIET meegecommit (staat in .gitignore).

# Verplicht: je OpenAI API-sleutel.
OPENAI_API_KEY=sk-...

# Lokaal: de PO-token-provider draait via Docker op deze poort.
# start.bat start die container automatisch. Laat dit zo staan.
POT_PROVIDER_URL=http://127.0.0.1:4416

# Optioneel: andere modellen.
# OPENAI_MODEL=gpt-5
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Voor GEHOST gebruik (bijv. Railway): Supadata haalt de YouTube-transcriptie
# op zonder dat het datacenter-IP geblokkeerd wordt. Zet je API-sleutel hier;
# dan gebruikt de app Supadata i.p.v. yt-dlp (en is de PO-token-provider en
# audio-transcriptie niet nodig). Lokaal laat je dit leeg.
# SUPADATA_API_KEY=sd_...

# Opslagmap voor de cache (dienstenlijst + verwerkte preken). Standaard ./data.
# Op Railway: koppel hier een volume aan zodat de cache een redeploy overleeft.
# DATA_DIR=/data

# Kerkdienstgemist werkt out-of-the-box (publieke anonieme token zit in de code).
# Alleen invullen als die token ooit verandert:
# KDG_TOKEN=

# Optioneel: standaardkanaal dat de app toont als er nog niets is geplakt.

# Optioneel: uur op zondag (0-23) waarna de dienstenlijst als verouderd geldt
# en opnieuw wordt opgehaald. Standaard 20.
# DIENSTEN_WEEKGRENS_UUR=20

# Alleen bij GEHOST gebruik via de eigen yt-dlp-route (zonder Supadata), als het
# datacenter-IP geblokkeerd wordt: een residentiële proxy of ingelogde cookies.
# YTDLP_PROXY=http://gebruiker:wachtwoord@host:poort
# YTDLP_COOKIES_B64=<base64 van een cookies.txt>

# ---- Accounts / SaaS (kerk-accounts, inschrijvers, e-mail) ----

# Database. Leeg = lokaal SQLite-bestand in DATA_DIR. Op Railway koppel je een
# Postgres-plugin; die zet DATABASE_URL automatisch.
# DATABASE_URL=postgresql://...

# Geheime sleutel voor sessies/cookies (login). Zet een lange willekeurige
# waarde in productie.
# SECRET_KEY=verander-dit-in-iets-langs-en-willekeurigs

# E-mail via Brevo (REST API v3 — de API-sleutel, NIET de SMTP-sleutel).
# Zonder BREVO_API_KEY worden mails niet verzonden maar naar de log geprint.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL is één GEVERIFIEERD afzenderadres van jouw eigen domein
# (in Brevo onder Senders bevestigen); wordt voor alle kerken gebruikt.
# BREVO_SENDER_EMAIL=no-reply@jouwdomein.nl
# BREVO_SENDER_NAAM is alleen een fallback-weergavenaam voor systeemmails
# (verificatie/reset). Inschrijvers zien als afzender de KERKNAAM; replies gaan
# naar het e-mailadres van de kerk.
# BREVO_SENDER_NAAM=Preekverwerker

# Centrale login vanuit Community Tools. Deze waarden blijven uitsluitend
# server-side. De bestaande login blijft altijd beschikbaar. De extra route
# staat standaard uit en wordt alleen actief met de expliciete schakelaar.
# COMMUNITY_TOOLS_SSO_ENABLED=false
# COMMUNITY_TOOLS_URL=https://communitytools.nl
# COMMUNITY_TOOLS_CLIENT_ID=
# COMMUNITY_TOOLS_CLIENT_SECRET=
COMMUNITY_TOOLS_MANAGEMENT_ENABLED=false
COMMUNITY_TOOLS_MANAGEMENT_SECRET=replace-with-a-separate-long-random-secret
